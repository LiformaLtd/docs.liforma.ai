---
import '@pagefind/default-ui/css/ui.css';
---

<div class="home-search">
  <button type="button" class="search-trigger" data-open-search aria-label="Search documentation">
    <span class="magnifier" aria-hidden="true">⌕</span>
    <span>Search docs</span>
    <kbd>⌘K</kbd>
  </button>
  <dialog class="search-dialog" data-search-dialog aria-label="Search documentation">
    <div class="dialog-frame">
      <button type="button" class="close" data-close-search>Close</button>
      <div id="home-pagefind"></div>
    </div>
  </dialog>
</div>

<script>
  const trigger = document.querySelector('[data-open-search]');
  const dialog = document.querySelector('[data-search-dialog]');
  const close = document.querySelector('[data-close-search]');

  const openSearch = () => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.showModal();
    document.body.style.overflow = 'hidden';
    setTimeout(() => dialog.querySelector('input')?.focus(), 0);
  };

  const closeSearch = () => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.close();
    document.body.style.overflow = '';
  };

  trigger?.addEventListener('click', openSearch);
  close?.addEventListener('click', closeSearch);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeSearch();
  });
  window.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog instanceof HTMLDialogElement && dialog.open ? closeSearch() : openSearch();
    }
  });

  if (!import.meta.env.DEV) {
    window.addEventListener('DOMContentLoaded', async () => {
      const { PagefindUI } = await import('@pagefind/default-ui');
      new PagefindUI({
        element: '#home-pagefind',
        bundlePath: '/pagefind/',
        showImages: false,
        showSubResults: true
      });
    });
  }
</script>

<style>
  .home-search { width: min(100%, 220px); }
  .search-trigger {
    width: 100%;
    min-height: 36px;
    display: flex;
    align-items: center;
    gap: .55rem;
    padding: .45rem .65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text-muted);
    cursor: pointer;
    font: inherit;
    font-size: .8125rem;
  }
  .search-trigger:hover { border-color: var(--border-strong); color: var(--text); }
  .search-trigger kbd {
    margin-left: auto;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: .05rem .35rem;
    background: var(--bg-subtle);
    color: var(--text-faint);
    font: inherit;
    font-size: .7rem;
  }
  .magnifier { font-size: 1rem; line-height: 1; }
  .search-dialog {
    width: min(92vw, 640px);
    max-height: min(80vh, 720px);
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: 0 24px 70px rgba(0,0,0,.22);
  }
  .search-dialog::backdrop { background: rgba(9,9,11,.42); backdrop-filter: blur(4px); }
  .dialog-frame { position: relative; padding: 1.25rem; overflow: auto; }
  .close {
    display: block;
    margin: 0 0 .75rem auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
    color: var(--text-muted);
    padding: .3rem .6rem;
    cursor: pointer;
  }
  #home-pagefind {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg-elevated);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--bg-subtle);
    --pagefind-ui-font: var(--font-sans);
  }
</style>
