---
import HomeSearch from '../components/HomeSearch.astro';
import { DEMO_EXPERIENCE_ID, externalLinks } from '../lib/navigation';

const helloWorld = `import { Experience } from '@liforma/client/react';

export function Demo() {
  return <Experience experienceId="${DEMO_EXPERIENCE_ID}" />;
}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Avatar Experiences for developers · Liforma Docs</title>
  <meta name="description" content="Developer documentation for Liforma Avatar Experiences." />
  <link rel="canonical" href="https://docs.liforma.ai/" />
  <link rel="icon" href="/favicon.svg" />
  <script is:inline>
    (() => {
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body>
  <div class="landing">
    <header class="landing-header">
      <div class="landing-header-inner">
        <a class="brand" href="/">
          <span class="brand-name">liforma</span>
          <span class="brand-docs">docs</span>
        </a>
        <nav class="landing-nav">
          <a href="/getting-started/quick-start/">Quick Start</a>
          <a href="/api-reference/sessions/">API Reference</a>
          <a href={externalLinks.pricing} target="_blank" rel="noopener noreferrer">Pricing</a>
        </nav>
        <HomeSearch />
        <button type="button" class="icon-btn" aria-label="Toggle theme" data-theme-toggle>
          <span aria-hidden="true">☼</span>
        </button>
      </div>
    </header>

    <main class="hero">
      <div class="hero-inner">
        <p class="eyebrow">Developer documentation</p>
        <h1>Avatar Experiences for your app</h1>
        <p class="hero-lead">
          Add intelligent animated avatars with one component. Real-time AI characters that listen,
          think, speak, animate, and interact inside your product.
        </p>
        <div class="hero-actions">
          <a class="btn primary" href="/getting-started/quick-start/">Quick Start</a>
          <a class="btn secondary" href="/api-reference/sessions/">View API Reference</a>
        </div>

        <div class="hero-code code-block">
          <div class="code-header"><span class="filename">Demo.tsx</span></div>
          <div class="code-inner">
            <pre><code>{helloWorld}</code></pre>
            <button type="button" class="copy-btn" data-copy-code>Copy</button>
          </div>
        </div>

        <p class="hero-note">
          Same component surface in Svelte, React, and Next.js. Liforma mints a Session Launch,
          starts the player runtime, and renders your avatar — audio, speech, animation, and
          lifecycle included. Coding agents: start at <a href="/llms.txt">llms.txt</a>.
        </p>
      </div>
    </main>

    <section class="cards" aria-label="Documentation sections">
      <div class="cards-inner">
        <a class="card" href="/getting-started/quick-start/">
          <h2>Quick Start</h2>
          <p>Embed your first avatar in under five minutes.</p>
          <span class="card-link">Get started →</span>
        </a>
        <a class="card" href="/avatar-experiences/overview/">
          <h2>Avatar Experiences</h2>
          <p>The full platform: characters, worlds, state, and tools.</p>
          <span class="card-link">Learn more →</span>
        </a>
        <a class="card" href="/capabilities/text-to-avatar/">
          <h2>Capabilities</h2>
          <p>Text-to-avatar, TTS, speech-to-speech, and more.</p>
          <span class="card-link">Explore →</span>
        </a>
        <a class="card" href="/guides/migrate-elevenlabs/">
          <h2>ElevenLabs migration</h2>
          <p>Move from voice agents to animated avatar experiences.</p>
          <span class="card-link">Migrate →</span>
        </a>
      </div>
    </section>

    <section class="flow" aria-label="How it works">
      <div class="flow-inner">
        <h2>How it works</h2>
        <div class="flow-diagram">
          <div class="flow-step"><span class="flow-label">Experience</span><p>Your reusable avatar configuration</p></div>
          <span class="flow-arrow" aria-hidden="true">↓</span>
          <div class="flow-step"><span class="flow-label">Session Launch</span><p>Public session facts plus opaque launch</p></div>
          <span class="flow-arrow" aria-hidden="true">↓</span>
          <div class="flow-step"><span class="flow-label">SDK</span><p>Audio, turns, avatar rendering, events</p></div>
        </div>
        <p class="flow-copy">
          You integrate at the Experience level. Transport, STT, TTS, and avatar rendering stay
          hidden inside the SDK.
        </p>
      </div>
    </section>

    <footer class="landing-footer">
      <p>
        <a href={externalLinks.www}>liforma.ai</a> ·
        <a href={externalLinks.pricing}>Pricing</a> ·
        <a href={externalLinks.meet}>Try a demo</a> ·
        <a href="/llms.txt">llms.txt</a> ·
        <a href="/openapi/sessions.json">OpenAPI</a>
      </p>
    </footer>
  </div>

  <script>
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('starlight-theme', next);
    });

    document.querySelector('[data-copy-code]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      try {
        await navigator.clipboard.writeText("import { Experience } from '@liforma/client/react';\n\nexport function Demo() {\n  return <Experience experienceId=\"exp_t0i7acmq\" />;\n}");
        button.textContent = 'Copied';
        setTimeout(() => button.textContent = 'Copy', 2000);
      } catch {}
    });
  </script>
</body>
</html>

<style is:global>
:root {
  color-scheme: light;
  --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, 'Cascadia Code', 'SF Mono', monospace;
  --bg: #fafafa; --bg-elevated: #fff; --bg-subtle: #f4f4f5; --bg-code: #18181b;
  --text: #18181b; --text-muted: #71717a; --text-faint: #a1a1aa;
  --border: #e4e4e7; --border-strong: #d4d4d8;
  --accent: #7c3aed; --accent-hover: #6d28d9; --accent-text: #6d28d9;
  --shadow-sm: 0 1px 2px rgba(0,0,0,.04); --shadow-md: 0 4px 12px rgba(0,0,0,.06);
  --radius: 10px; --radius-sm: 6px; --header-height: 56px;
}
:root[data-theme='dark'] {
  color-scheme: dark;
  --bg:#09090b; --bg-elevated:#18181b; --bg-subtle:#27272a; --bg-code:#09090b;
  --text:#fafafa; --text-muted:#a1a1aa; --text-faint:#71717a;
  --border:#27272a; --border-strong:#3f3f46;
  --accent:#a78bfa; --accent-hover:#c4b5fd; --accent-text:#c4b5fd;
  --shadow-sm:0 1px 2px rgba(0,0,0,.3); --shadow-md:0 4px 12px rgba(0,0,0,.4);
}
*,:before,:after { box-sizing:border-box; }
html { font-family:var(--font-sans); background:var(--bg); color:var(--text); -webkit-font-smoothing:antialiased; }
body { margin:0; min-height:100dvh; }
a { color:var(--accent-text); text-decoration:none; }
a:hover { text-decoration:underline; }
.landing { min-height:100dvh; display:flex; flex-direction:column; }
.landing-header { position:sticky; top:0; z-index:50; border-bottom:1px solid var(--border); background:color-mix(in srgb,var(--bg) 85%,transparent); backdrop-filter:blur(12px); }
.landing-header-inner { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.75rem; max-width:1080px; margin:0 auto; padding:0 1.5rem; min-height:var(--header-height); }
.brand { display:flex; align-items:baseline; gap:.4rem; text-decoration:none; color:var(--text); }
.brand-name { font-weight:700; font-size:1.05rem; letter-spacing:-.03em; }
.brand-docs { font-size:.8125rem; color:var(--text-muted); font-weight:500; }
.landing-nav { display:flex; gap:1.25rem; }
.landing-nav a { font-size:.875rem; color:var(--text-muted); font-weight:500; text-decoration:none; }
.landing-nav a:hover { color:var(--text); }
.icon-btn { display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--bg-elevated); color:var(--text-muted); cursor:pointer; }
.hero { flex:1; padding:4rem 1.5rem 3rem; }
.hero-inner { max-width:720px; margin:0 auto; text-align:center; }
.eyebrow { margin:0 0 1rem; font-size:.8125rem; font-weight:600; text-transform:uppercase; letter-spacing:.1em; color:var(--accent-text); }
.hero h1 { font-size:clamp(2.25rem,5vw,3.25rem); line-height:1.25; margin:0 0 1.25rem; letter-spacing:-.03em; }
.hero-lead { margin:0 auto 2rem; font-size:1.2rem; line-height:1.6; color:var(--text-muted); max-width:36rem; }
.hero-actions { display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap; margin-bottom:2.5rem; }
.btn { display:inline-flex; align-items:center; padding:.65rem 1.25rem; border-radius:var(--radius); font-size:.9375rem; font-weight:600; text-decoration:none; }
.btn.primary { background:var(--accent); color:#fff; border:1px solid var(--accent); }
.btn.primary:hover { background:var(--accent-hover); text-decoration:none; }
.btn.secondary { background:var(--bg-elevated); color:var(--text); border:1px solid var(--border-strong); }
.btn.secondary:hover { border-color:var(--text-faint); text-decoration:none; }
.hero-code { text-align:left; margin-bottom:1.25rem; }
.code-block { margin:1.25rem 0 1.5rem; border-radius:var(--radius); overflow:hidden; border:1px solid var(--border-strong); background:var(--bg-code); box-shadow:var(--shadow-sm); }
.code-header { padding:.5rem 1rem; border-bottom:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.03); }
.filename { font-family:var(--font-mono); font-size:.75rem; color:#a1a1aa; }
.code-inner { position:relative; }
pre { margin:0; padding:1.1rem 1.15rem; overflow-x:auto; }
pre code { font-family:var(--font-mono); font-size:.8125rem; line-height:1.6; color:#e4e4e7; white-space:pre; }
.copy-btn { position:absolute; top:.65rem; right:.65rem; padding:.3rem .65rem; font-size:.75rem; font-family:var(--font-sans); font-weight:500; color:#d4d4d8; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); border-radius:var(--radius-sm); cursor:pointer; }
.hero-note { margin:0; font-size:.9375rem; color:var(--text-muted); line-height:1.6; }
.cards { padding:2rem 1.5rem 4rem; background:var(--bg-subtle); border-top:1px solid var(--border); }
.cards-inner { max-width:1080px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1rem; }
.card { display:block; padding:1.35rem 1.5rem; background:var(--bg-elevated); border:1px solid var(--border); border-radius:var(--radius); text-decoration:none; color:inherit; }
.card:hover { border-color:var(--border-strong); box-shadow:var(--shadow-md); text-decoration:none; }
.card h2 { margin:0 0 .5rem; font-size:1.05rem; }
.card p { margin:0 0 1rem; font-size:.875rem; color:var(--text-muted); line-height:1.5; }
.card-link { font-size:.8125rem; font-weight:600; color:var(--accent-text); }
.flow { padding:3rem 1.5rem 4rem; }
.flow-inner { max-width:480px; margin:0 auto; text-align:center; }
.flow h2 { margin:0 0 1.5rem; font-size:1.25rem; }
.flow-diagram { display:flex; flex-direction:column; align-items:center; gap:.5rem; margin-bottom:1.25rem; }
.flow-step { width:100%; padding:1rem 1.25rem; background:var(--bg-elevated); border:1px solid var(--border); border-radius:var(--radius); }
.flow-label { display:block; font-weight:600; font-size:.9375rem; margin-bottom:.25rem; }
.flow-step p { margin:0; font-size:.8125rem; color:var(--text-muted); }
.flow-arrow { color:var(--text-faint); font-size:1.25rem; }
.flow-copy { margin:0; font-size:.9375rem; color:var(--text-muted); line-height:1.6; }
.landing-footer { padding:1.5rem; border-top:1px solid var(--border); text-align:center; }
.landing-footer p { margin:0; font-size:.875rem; color:var(--text-muted); }
.landing-footer a { color:var(--text-muted); }
@media(max-width:640px) {
  .landing-nav { display:none; }
  .home-search { order:3; width:100%; }
  .landing-header-inner :global(.home-search) { order:3; width:100%; }
  .hero { padding-top:2.5rem; }
}
</style>
