---
interface Link {
  title: string;
  href: string;
}

interface Props {
  links?: readonly Link[];
}

const { links = [] } = Astro.props;
---

{links.length > 0 && (
  <nav class="liforma-next-steps" aria-label="Next steps">
    <h2>Next steps</h2>
    <ul>
      {links.map((link) => <li><a href={link.href}>{link.title} →</a></li>)}
    </ul>
  </nav>
)}
